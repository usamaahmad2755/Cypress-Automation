    "cy:dev": "cross-env TEST_ENV=dev cypress run",
    "cy:staging": "cross-env TEST_ENV=staging cypress run",
    "cy:prod": "cross-env TEST_ENV=prod cypress run",
    "cy:dev:open": "cross-env TEST_ENV=dev cypress open",
    "cy:staging:open": "cross-env TEST_ENV=staging cypress open",
    "cy:prod:open": "cross-env TEST_ENV=prod cypress open",
    "cy:retry": "cypress run --env failed=true",
    "bs:dev": "cross-env ENV=dev BASE_URL=https://express.notarypro.ca npx browserstack-cypress run",
    "bs:staging": "cross-env ENV=staging BASE_URL=https://notarypro.atlassian.net/jira/software/projects/QA/boards/78?selectedIssue=QA-7 npx browserstack-cypress run",
